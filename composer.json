{
    "name": "ctw/ctw-middleware-pagecache",
    "description": "This PSR-15 middleware provides full page caching for Mezzio applications.",
    "license": "BSD-3-Clause",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ctw/ctw-middleware": "dev-php85",
        "laminas/laminas-cache": "^4.3",
        "laminas/laminas-cache-storage-adapter-filesystem": "^3.2",
        "laminas/laminas-diactoros": "^3.0",
        "laminas/laminas-serializer": "^3.0",
        "mezzio/mezzio-fastroute": "^3.1",
        "mezzio/mezzio-session": "^1.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "ctw/ctw-qa": "dev-php85",
        "phpunit/phpunit": "^13.0",
        "symfony/var-dumper": "^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ctw\\Middleware\\PageCacheMiddleware\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CtwTest\\Middleware\\PageCacheMiddleware\\": "test"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ecs": "php vendor/bin/ecs --clear-cache",
        "ecs-fix": "php vendor/bin/ecs --clear-cache --fix",
        "phpstan": "bash vendor/ctw/ctw-qa/bin/phpstan.sh",
        "phpstan-baseline": "bash vendor/ctw/ctw-qa/bin/phpstan-baseline.sh",
        "qa": [
            "@rector",
            "@ecs",
            "@phpstan"
        ],
        "qa-fix": [
            "@rector-fix",
            "@ecs-fix",
            "@phpstan"
        ],
        "rector": "php vendor/bin/rector process --clear-cache --dry-run",
        "rector-fix": "php vendor/bin/rector process --clear-cache",
        "test": "export XDEBUG_MODE=coverage ; php vendor/bin/phpunit"
    }
}
